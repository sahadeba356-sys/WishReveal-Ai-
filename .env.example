# OPENAI_API_KEY: Official OpenAI API Key for ChatGPT capabilities.
# Stored securely on the server-side environment. Never exposed to browser or frontend.
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# OPENAI_MODEL: Supported model for ChatGPT responses (defaults to gpt-4o-mini).
# Options: gpt-4o-mini, gpt-4o, chatgpt-4o-latest
OPENAI_MODEL="gpt-4o-mini"

# GEMINI_API_KEY: Fallback Gemini API key if OpenAI is not provided.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

